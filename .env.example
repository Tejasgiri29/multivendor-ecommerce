# Copy to .env and adjust. Docker Compose reads this file automatically.
POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=change_this_db_password

# JWT signing secret: at least 32 characters. Generate e.g. with:  openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MINUTES=120

# Insert demo data (admin, seller, customer, categories, products, coupons) when the DB is empty
SEED_ENABLED=true

# Origins allowed by CORS (only needed when the frontend is NOT served through the nginx proxy)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Host ports
BACKEND_PORT=8080
FRONTEND_PORT=3000
